{
  "version": 1,
  "policy": {
    "minimumIndependentSourcesForProposal": 3,
    "minimumSignalScore": 55,
    "minimumEditorialSignalScore": 28,
    "minimumRankedCommunitySignalScore": 18,
    "historyDays": 30,
    "storeFullRemoteContent": false,
    "executeRemoteInstructions": false,
    "topicTaxonomy": {
      "purposeful-motion": ["motion", "animation", "transition", "kinetic", "choreography", "gsap"],
      "accessible-interaction": ["accessibility", "accessible", "wcag", "screen reader", "keyboard"],
      "performance-budget": ["performance", "core web vitals", "lcp", "inp", "cls"],
      "creative-web-3d": ["three.js", "webgpu", "webgl", "shader", "3d", "tsl"],
      "design-systems": ["design system", "design tokens", "component system"],
      "responsive-recomposition": ["responsive", "mobile", "container query", "container queries"],
      "editorial-structure": ["editorial", "digital archive", "typography", "type system"],
      "interaction-as-story": ["interaction", "interactive", "storytelling", "digital experience"]
    }
  },
  "sources": [
    {
      "id": "codrops-rss",
      "type": "rss",
      "name": "Codrops",
      "url": "https://tympanus.net/codrops/feed/",
      "trust": 0.9,
      "enabled": true
    },
    {
      "id": "smashing-magazine-rss",
      "type": "rss",
      "name": "Smashing Magazine",
      "url": "https://www.smashingmagazine.com/feed/",
      "trust": 0.9,
      "enabled": true
    },
    {
      "id": "web-dev-rss",
      "type": "rss",
      "name": "web.dev",
      "url": "https://web.dev/feed.xml",
      "trust": 0.95,
      "enabled": true
    },
    {
      "id": "mdn-blog-rss",
      "type": "rss",
      "name": "MDN Blog",
      "url": "https://developer.mozilla.org/en-US/blog/rss.xml",
      "trust": 0.95,
      "enabled": true
    },
    {
      "id": "youtube-design-motion",
      "type": "youtube-search",
      "name": "YouTube design and motion",
      "queries": ["web design case study", "motion design web animation"],
      "trust": 0.65,
      "enabled": true,
      "requiresEnv": "YOUTUBE_API_KEY"
    },
    {
      "id": "threads-design-discovery",
      "type": "threads-search",
      "name": "Threads public design discovery",
      "queries": [
        "web interaction design",
        "web motion design",
        "creative coding webgl",
        "accessible web design",
        "responsive web design",
        "design systems"
      ],
      "searchTypes": ["TOP", "RECENT"],
      "limitPerQuery": 5,
      "maxSignals": 60,
      "trust": 0.45,
      "enabled": true,
      "requiresEnv": "THREADS_ACCESS_TOKEN"
    },
    {
      "id": "threads-owned-insights",
      "type": "threads-insights",
      "name": "Threads authorized post insights",
      "postIdsEnv": "THREADS_POST_IDS",
      "trust": 0.6,
      "enabled": true,
      "requiresEnv": "THREADS_ACCESS_TOKEN"
    },
    {
      "id": "manual-curation",
      "type": "manual-json",
      "name": "Curated community links",
      "path": "evolution/manual-signals.json",
      "trust": 0.7,
      "enabled": true
    }
  ]
}
