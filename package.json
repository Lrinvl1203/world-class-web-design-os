{
  "name": "world-class-web-design-os",
  "version": "0.2.0",
  "private": true,
  "description": "Evidence-led operating system for distinctive, accessible, and verifiable agentic web design.",
  "license": "MIT",
  "author": "Lrinvl1203",
  "homepage": "https://github.com/Lrinvl1203/world-class-web-design-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lrinvl1203/world-class-web-design-os.git"
  },
  "bugs": {
    "url": "https://github.com/Lrinvl1203/world-class-web-design-os/issues"
  },
  "keywords": [
    "agent-skills",
    "web-design",
    "design-system",
    "accessibility",
    "visual-qa",
    "codex",
    "frontend"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    ".codex/skills",
    "cli",
    "config",
    "evolution/README.md",
    "evolution/manual-signals.json",
    "schemas",
    "scripts/evolution",
    "scripts/lib",
    "scripts/evaluate-routes.mjs",
    "scripts/install-global.mjs",
    "templates",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "bin": {
    "web-design-os": "./cli/web-design-os.mjs"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "web-design-os": "node cli/web-design-os.mjs",
    "eval:skills": "node cli/web-design-os.mjs eval",
    "evolve:daily": "node cli/web-design-os.mjs evolve",
    "test:unit": "node --test tests/*.test.mjs",
    "qa:install": "npx playwright install chromium",
    "qa:capture": "node scripts/capture-screenshots.mjs",
    "qa:visual": "playwright test",
    "qa:launch": "node scripts/run-launch-qa.mjs",
    "build:launch-assets": "node scripts/build-launch-assets.mjs",
    "prepack": "npm run validate && npm run eval:skills"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.0"
  }
}
