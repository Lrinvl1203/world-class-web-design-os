{
  "name": "world-class-web-design-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wdx": "./cli/wdx.mjs"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "wdx": "node cli/wdx.mjs",
    "eval:skills": "node cli/wdx.mjs eval",
    "evolve:daily": "node cli/wdx.mjs evolve",
    "test:unit": "node --test tests/*.test.mjs",
    "qa:install": "npx playwright install chromium",
    "qa:capture": "node scripts/capture-screenshots.mjs",
    "qa:visual": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.0"
  }
}
